# StealthAuction Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# PRIVATE KEYS & WALLETS
# =============================================================================
# Your private key for deployment and testing
# WARNING: Never commit real private keys to version control
PRIVATE_KEY=your_private_key_here

# Optional: Additional private keys for testing
# USER1_PRIVATE_KEY=0x...
# USER2_PRIVATE_KEY=0x...

# =============================================================================
# RPC ENDPOINTS
# =============================================================================
# Fhenix RPC endpoints
FHENIX_TESTNET_RPC=https://testnet.fhenix.zone/evm
FHENIX_MAINNET_RPC=https://mainnet.fhenix.zone/evm

# Local development
ANVIL_RPC=http://localhost:8545

# Optional: Other testnets
# SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# ARBITRUM_TESTNET_RPC=https://goerli-rollup.arbitrum.io/rpc

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Gas configuration
GAS_LIMIT=30000000
GAS_PRICE=20000000000

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test configuration
FUZZ_RUNS=1000
FORK_URL=https://testnet.fhenix.zone/evm

# Coverage settings
COVERAGE_REPORTS=true
COVERAGE_HTML=true

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Debug settings
DEBUG=false
VERBOSE=false

# Logging
LOG_LEVEL=info

# =============================================================================
# SECURITY
# =============================================================================
# Never commit these to version control
# Add .env to your .gitignore file
# Use environment variables or secure vaults for production
